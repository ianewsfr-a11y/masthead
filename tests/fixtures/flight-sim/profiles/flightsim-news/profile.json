{
  "id": "flightsim-news",
  "name": "Flight simulation news",
  "match": "match.md",
  "analysis": "analysis.md",
  "content": {
    "analysis_max_chars": 4000,
    "enrichment_max_chars": 8000,
    "sampling": "prefix"
  },
  "enrichment": {
    "prompt": "enrichment.md",
    "blocks": [
      { "id": "summary", "type": "section", "tools": [], "primary": true },
      { "id": "background", "type": "section", "tools": ["history_search", "web_search"], "optional": true }
    ]
  }
}
